* text eol=lf

# Binary font files: git must never treat them as text,
# otherwise normalization strips trailing bytes and browsers (OTS) reject
# them with "Failed to convert WOFF 2.0 font to SFNT" / "incorrect file size in WOFF header".
*.eot binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.ico binary
